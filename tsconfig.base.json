{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@continuum/focus": ["packages/focus/src/index.ts"],
      "@continuum/virtual": ["packages/virtual/src/index.ts"],
      "@continuum/tokens": ["packages/tokens/src/index.ts"],
      "@continuum/ui": ["packages/ui/src/index.ts"]
    }
  }
}
