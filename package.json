{
  "name": "continuum",
  "private": true,
  "version": "0.0.0",
  "description": "Continuum — Cross-Surface Streaming UI (Web + Smart TV)",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages e2e --ext .ts,.tsx",
    "format": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter @continuum/app run dev",
    "size": "size-limit"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.2.0",
    "@playwright/test": "^1.46.0",
    "@size-limit/preset-app": "^11.1.4",
    "size-limit": "^11.1.4",
    "@lhci/cli": "^0.14.0"
  },
  "size-limit": [
    {
      "name": "app JS (gzip)",
      "path": [
        "packages/app/dist/assets/*.js",
        "!packages/app/dist/assets/*-legacy-*.js"
      ],
      "limit": "180 KB"
    },
    {
      "name": "app CSS (gzip)",
      "path": "packages/app/dist/assets/*.css",
      "limit": "40 KB"
    }
  ]
}
