{
  "name": "@continuum/bff",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify BFF — turns TMDB's entity-shaped data into the page-shaped contract in BRD-TRD §13.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "fetch-snapshot": "tsx src/fetch-snapshot.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
