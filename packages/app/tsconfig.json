{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No outDir/rootDir: this project only type-checks (noEmit) — Vite does
    // the actual bundling — and app/src imports source files from sibling
    // workspace packages, which rootDir would otherwise reject.
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src"]
}
