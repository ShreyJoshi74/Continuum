{
  "name": "@continuum/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Density and theme token source, built to CSS custom properties and typed TS constants.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./density.css": "./src/generated/density.css"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "pnpm run build:tokens && tsc -p tsconfig.json",
    "test": "pnpm run build:tokens && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
